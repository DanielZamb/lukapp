{
  "expo": {
    "name": "Lukapp U01",
    "slug": "lukapp-u01",
    "version": "0.1.0",
    "scheme": "lukapp-u01",
    "orientation": "portrait",
    "ios": {
      "bundleIdentifier": "com.lukapp.u01.dev",
      "buildNumber": "2"
    },
    "android": {
      "package": "com.lukapp.u01.dev",
      "versionCode": 2
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "@clerk/expo",
      [
        "@clerk/expo-native-components",
        {
          "theme": "./clerk-theme.json"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/geist/400Regular/Geist_400Regular.ttf"
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your financial information in Lukapp."
        }
      ],
      "./plugins/with-entry-privacy.cjs"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
