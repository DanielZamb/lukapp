{
  "expo": {
    "name": "Lukapp",
    "slug": "lukapp-u01",
    "version": "0.1.0",
    "scheme": "lukapp-u01",
    "orientation": "portrait",
    "ios": {
      "bundleIdentifier": "com.lukapp.u01.dev",
      "buildNumber": "3"
    },
    "android": {
      "package": "com.lukapp.u01.dev",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#6d28d9",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-symbol.png",
          "imageWidth": 160,
          "backgroundColor": "#6d28d9",
          "dark": {
            "image": "./assets/brand/splash-symbol.png",
            "backgroundColor": "#21132f"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "@clerk/expo",
      [
        "@clerk/expo-native-components",
        {
          "theme": "./clerk-theme.json"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/geist/400Regular/Geist_400Regular.ttf"
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your financial information in Lukapp."
        }
      ],
      "./plugins/with-entry-privacy.cjs"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/brand/icon.png",
    "web": {
      "favicon": "./assets/brand/favicon.png"
    },
    "primaryColor": "#6d28d9"
  }
}
