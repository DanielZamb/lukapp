{
  "expo": {
    "name": "Lukapp",
    "slug": "lukapp",
    "version": "0.1.0",
    "scheme": "lukapp",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.sennkai.lukapp.dev",
      "supportsTablet": true
    },
    "android": {
      "package": "com.sennkai.lukapp.dev",
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-dev-client",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your money and local drafts."
        }
      ],
      "expo-secure-store",
      "@clerk/expo",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
