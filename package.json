{
  "name": "lukapp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "crap": "node scripts/backend-quality.mjs coverage",
    "quality:backend": "node scripts/backend-quality.mjs",
    "typecheck": "tsc --noEmit",
    "mutate": "node scripts/backend-quality.mjs mutation",
    "mobile:start": "pnpm --filter @lukapp/mobile start",
    "mobile:typecheck": "pnpm --filter @lukapp/mobile typecheck",
    "mobile:test": "pnpm --filter @lukapp/mobile test"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "3.2.7",
    "convex-test": "0.0.59",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@clerk/backend": "3.23.2",
    "convex": "1.46.0",
    "convex-helpers": "0.1.128"
  }
}
